# Optional LLM Claim Parser Configuration (Phase 10)
# The core FieldGuard verifier and deterministic parser work 100% offline without any API key.
# To enable the optional LLM-based claim parser experiment, configure the variables below:

FIELDGUARD_LLM_PROVIDER=
FIELDGUARD_LLM_MODEL=
FIELDGUARD_LLM_ENDPOINT=
FIELDGUARD_LLM_API_KEY=
FIELDGUARD_LLM_TIMEOUT_SEC=30
FIELDGUARD_LLM_MAX_RETRIES=2
FIELDGUARD_LLM_TEMPERATURE=0.0
FIELDGUARD_LLM_MAX_TOKENS=512
